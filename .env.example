# promptstrike environment template.
# Copy to your env file OUTSIDE this repo and fill in real values. NEVER commit real secrets.
# Resolution order: PROMPTSTRIKE_ENV_FILE (exact file) -> $PROMPTSTRIKE_SECRETS_DIR/.env
#                   -> ~/.promptstrike/.env. Both env vars are optional.

# SAFETY DEFAULT: when true, no live network request is ever sent to a target; probes render only.
PROMPTSTRIKE_DRY_RUN=true

# Requests/sec cap applied to ALL target traffic (no-DoS guard). Keep conservative.
PROMPTSTRIKE_RATE_LIMIT_RPS=1.0

# Where the findings DB, program defs, and evidence live (gitignored). Blank -> ~/.promptstrike/data
PROMPTSTRIKE_DATA_DIR=

# Anthropic API key for AI-assisted report drafting (optional; drafting is offline-mockable without it).
ANTHROPIC_API_KEY=

# Live-target endpoint settings (only used on `test --live`; ignored in dry run).
# Model name sent in the OpenAI-compatible chat payload. Blank -> gpt-4o-mini.
PROMPTSTRIKE_TARGET_MODEL=
# Bearer token for the live target endpoint. Blank -> no Authorization header is sent.
PROMPTSTRIKE_TARGET_API_KEY=
